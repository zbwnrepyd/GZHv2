        "1": "<style>\n* { box-sizing: border-box; }\nbody { margin: 0; background: #eee; font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", Arial, sans-serif; }\n.card { width: 900px; height: 1200px; position: relative; overflow: hidden; background: radial-gradient(circle at 18% 42%, rgba(220,216,206,.34), transparent 26%), radial-gradient(circle at 80% 18%, rgba(255,255,255,.9), transparent 30%), linear-gradient(135deg, #fbfaf6 0%, #f3f0e8 100%); color: #121212; }\n.card::before { content: \"\"; position: absolute; inset: 0; opacity: .35; background-image: linear-gradient(45deg, rgba(0,0,0,.035) 1px, transparent 1px), linear-gradient(-45deg, rgba(0,0,0,.025) 1px, transparent 1px); background-size: 18px 18px; pointer-events: none; }\n.card::after { content: \"\"; position: absolute; width: 620px; height: 620px; left: -220px; bottom: 30px; border-radius: 50%; background: radial-gradient(circle, rgba(210,207,197,.18), transparent 66%); }\n.inner { position: relative; z-index: 2; height: 100%; padding: 90px 92px 70px; display: flex; flex-direction: column; align-items: center; }\n.kicker { font-size: 38px; font-weight: 500; letter-spacing: .03em; color: #222; margin-top: 5px; margin-bottom: 56px; }\n.title { font-size: 96px; line-height: 1.17; font-weight: 800; letter-spacing: -0.06em; text-align: center; margin: 0; }\n.icon-wrap { width: 104px; height: 104px; margin-top: 62px; position: relative; }\n.drink { position: absolute; left: 24px; top: 18px; width: 54px; height: 74px; border: 5px solid #17262a; border-radius: 10px 10px 18px 18px; background: linear-gradient(#f59b3d 0 52%, #f47a2e 52% 100%); transform: rotate(-4deg); box-shadow: 0 3px 0 rgba(0,0,0,.12); }\n.drink::before { content: \"\"; position: absolute; width: 42px; height: 42px; left: -28px; top: -15px; border-radius: 50%; border: 4px solid #17262a; background: radial-gradient(circle at center, transparent 0 32%, #f0b33c 33% 46%, transparent 47%); }\n.drink::after { content: \"\"; position: absolute; width: 38px; height: 5px; right: -24px; top: -22px; background: #17262a; border-radius: 9px; transform: rotate(-65deg); }\n.bubble { position: absolute; width: 6px; height: 6px; background: #222; border-radius: 50%; left: 42px; top: 40px; box-shadow: 15px 16px 0 #222, 3px 31px 0 #222, 22px 40px 0 #222; }\n.subtitle { margin-top: auto; margin-bottom: 150px; font-size: 37px; font-weight: 800; letter-spacing: -0.04em; }\n.brand { position: absolute; left: 50%; bottom: 72px; transform: translateX(-50%); display: flex; align-items: center; gap: 16px; font-size: 27px; font-weight: 700; }\n.brand-mark { width: 54px; height: 54px; position: relative; }\n.brand-mark::before, .brand-mark::after { content: \"\"; position: absolute; inset: 11px; border: 3px solid #142735; border-radius: 50%; transform: rotate(30deg) scaleX(.58); }\n.brand-mark::after { transform: rotate(-30deg) scaleX(.58); }\n.brand-dot { position: absolute; width: 8px; height: 8px; right: 6px; top: 10px; border-radius: 50%; background: #f28a28; }\n</style>\n<article class=\"card\">\n  <div class=\"inner\">\n    <div class=\"kicker\">三分钟认识一家AI初创公司</div>\n    <h1 class=\"title\">公司名称</h1>\n    <div class=\"icon-wrap\"><div class=\"drink\"><span class=\"bubble\"></span></div></div>\n    <div class=\"subtitle\">一句话描述这家公司</div>\n    <div class=\"brand\"><div class=\"brand-mark\"><span class=\"brand-dot\"></span></div><span>AI Startups</span></div>\n  </div>\n</article>",
