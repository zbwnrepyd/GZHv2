# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx

# Tavily Search API.
# Use either TAVILY_API_KEY or TAVILY_API_KEYS. The multi-key list is preferred
# when you have several dev keys; quota responses try the next key.
TAVILY_API_KEY=tvly-xxxxxxxxxxxx
# TAVILY_API_KEYS=tvly-xxxxxxxxxxxx,tvly-yyyyyyyyyyyy

# YouTube Data API v3
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxx

# Image search APIs (both free tier)
# https://www.pexels.com/api/ — 200 req/h
PEXELS_API_KEY=...
# https://unsplash.com/developers — 50 req/h (demo)
UNSPLASH_ACCESS_KEY=...

# Image generation API (DALL-E compatible endpoint, fallback only)
IMAGE_API_KEY=sk-xxxxxxxxxxxx
IMAGE_API_URL=https://api.openai.com/v1/images/generations

# Flask
FLASK_PORT=5050

# Database paths
# Optional. Defaults to this project's db/ directory.
# DB_PATH_RESEARCH=/absolute/path/to/research_db.sqlite
# DB_PATH_FINAL=/absolute/path/to/final_db.sqlite

# HTTP proxy
# Tavily and YouTube are blocked from mainland China; set a local proxy.
# HTTPS_PROXY=http://127.0.0.1:1087
# HTTP_PROXY=http://127.0.0.1:1087

# Image storage
# Optional. Defaults to this project's images/ directory.
# IMAGES_DIR=/absolute/path/to/images
