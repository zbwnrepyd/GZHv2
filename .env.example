# Flask
FLASK_PORT=5050

# Database paths
# Optional. Defaults to this project's db/ directory.
# DB_PATH_RESEARCH=/absolute/path/to/research_db.sqlite
# DB_PATH_FINAL=/absolute/path/to/final_db.sqlite

# Image storage
# Optional. Defaults to this project's images/ directory.
# IMAGES_DIR=/absolute/path/to/images
